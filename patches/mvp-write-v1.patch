@@ -0,0 +1,50 @@
+"""Bounded durable nonce replay guard, private to integration backend."""
+from collections.abc import MutableMapping
+import json
+import os
+from pathlib import Path
+import tempfile
+import time
+
+class ReplayGuard(MutableMapping):
+    def __init__(self, directory, clock=time.time):
+        self.path = Path(directory) / 'replay-v1.json'
+        self.clock = clock
+        self.data = {}
+        if self.path.exists():
+            loaded = json.loads(self.path.read_text())
+            if not isinstance(loaded, dict) or len(loaded) > 4096:
+                raise ValueError('Invalid replay journal')
+            self.data = {k: v for k, v in loaded.items() if type(v) in (int, float) and v > clock()}
+
+    def __getitem__(self, key):
+        return self.data[key]
+
+    def __iter__(self):
+        return iter(self.data)
+
+    def __len__(self):
+        return len(self.data)
+
+    def __setitem__(self, key, value):
+        data = {k: v for k, v in self.data.items() if v > self.clock()}
+        data[key] = value
+        self._save(data)
+        self.data = data
+
+    def __delitem__(self, key):
+        # Expired entries need no durable removal; next insertion prunes journal.
+        del self.data[key]
+
+    def _save(self, data):
+        self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+        fd, tmp = tempfile.mkstemp(dir=self.path.parent)
+        try:
+            with os.fdopen(fd, 'w') as stream:
+                json.dump(data, stream, sort_keys=True)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(tmp, self.path)
+        finally:
+            if os.path.exists(tmp):
+                os.unlink(tmp)
