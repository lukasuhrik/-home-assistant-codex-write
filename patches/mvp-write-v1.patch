@@ -0,0 +1,124 @@
+"""HA-native MVP operations; execute only in the Home Assistant event loop."""
+import asyncio
+import time
+from .write_contract import Invalid, Denied, authorize, result, normalized
+
+class Backend:
+    def __init__(self, adapter, secret, audit, clock=time.time):
+        self.adapter, self.secret, self.audit, self.clock = adapter, secret, audit, clock
+        self.seen = {}
+        self.lock = asyncio.Lock()
+
+    async def execute(self, request, proof):
+        async with self.lock:
+            try:
+                authorize(request, proof, self.secret, self.clock(), self.seen)
+                self.audit.emit('START', request)
+            except Denied:
+                return self._rejected(request, 'PERMISSION_DENIED')
+            except Invalid:
+                return self._rejected(request, 'VALIDATION_ERROR')
+            except Exception:
+                return result(request, 'WRITE_FAILED', warnings=['Audit unavailable; no mutation performed'])
+            try:
+                outcome = await self._perform(request)
+            except (Invalid, ValueError, KeyError):
+                outcome = result(request, 'VALIDATION_ERROR')
+            except Exception:
+                # Exception strings can contain credentials or service data.
+                outcome = result(request, 'WRITE_FAILED', warnings=['Backend failure; read-back required before retry'])
+            try:
+                self.audit.emit('RESULT', request, outcome)
+            except Exception:
+                outcome = result(request, 'VERIFY_FAILED', warnings=['Result audit failed; mutation may have occurred'])
+            return outcome
+
+    def _rejected(self, request, status):
+        outcome = result(request, status)
+        # Unauthenticated identity/targets must not be copied to the audit sink.
+        safe = {'operation': 'rejected_request'}
+        try:
+            self.audit.emit('START', safe)
+            self.audit.emit('RESULT', safe, outcome)
+        except Exception:
+            pass  # Denial is fail-closed even when audit is unavailable.
+        return outcome
+
+    async def _perform(self, r):
+        p, operation = r['payload'], r['operation']
+        if operation == 'ha_service_call':
+            before = self.adapter.update_state()
+            if not before or not before.get('installed_version') or not before.get('latest_version'):
+                raise Invalid('Update metadata missing')
+            strip = lambda x: x.removeprefix('v')
+            if strip(before['installed_version']) == strip(before['latest_version']):
+                return result(r, 'NO_CHANGE', before, before, True)
+            if strip(before['latest_version']) != '0.1.70':
+                raise Invalid('Latest version is outside MVP approval')
+            if r['dry_run']:
+                return result(r, 'DRY_RUN', before, before)
+            await self.adapter.install_update(p.get('data', {}).get('version', before['latest_version']))
+            after = self.adapter.update_state()
+            verified = bool(after and strip(after.get('installed_version', '')) == '0.1.70')
+            out = result(r, 'SUCCESS' if verified else 'VERIFY_FAILED', before, after, verified)
+            out['restart_required'] = True
+            return out
+        if operation == 'ha_area_create':
+            existing = next((a for a in self.adapter.areas() if normalized(a['name']) == normalized(p['name'])), None)
+            if existing:
+                return result(r, 'ALREADY_EXISTS', existing, existing, True)
+            self._floor(p)
+            change = self._change(p)
+            if r['dry_run']:
+                return result(r, 'DRY_RUN', None, {'planned': change})
+            area_id = self.adapter.create(change)
+            after = self.adapter.area(area_id)
+            verified = self._matches(after, change)
+            return result(r, 'SUCCESS' if verified else 'VERIFY_FAILED', None, after, verified)
+        before = self.adapter.area(p['area_id'])
+        if before is None:
+            raise Invalid('Unknown Area')
+        if operation == 'ha_area_get_environment_entities':
+            after = {'temperature_entity': before['temperature_entity_id'],
+                     'humidity_entity': before['humidity_entity_id'],
+                     'candidates': self.adapter.candidates(p['area_id'])}
+            return result(r, 'SUCCESS', before, after, True)
+        if operation == 'ha_area_set_temperature_entity':
+            candidate = next((e for e in self.adapter.candidates(p['area_id']) if e['entity_id'] == p['entity_id']), None)
+            if not candidate or candidate['device_class'] != 'temperature' or candidate['diagnostic'] or candidate['unit'] not in ('°C', '°F', 'K'):
+                raise Invalid('Entity is not an eligible environmental temperature')
+            if 'device_temperature' in p['entity_id']:
+                raise Invalid('Device temperature cannot be preferred')
+            change = {'temperature_entity_id': p['entity_id']}
+        else:
+            self._floor(p)
+            change = self._change({k: v for k, v in p.items() if k != 'area_id'})
+            if 'name' in change and any(a['area_id'] != p['area_id'] and normalized(a['name']) == normalized(change['name']) for a in self.adapter.areas()):
+                raise Invalid('Duplicate Area name')
+        if self._matches(before, change):
+            return result(r, 'NO_CHANGE', before, before, True)
+        if r['dry_run']:
+            return result(r, 'DRY_RUN', before, {**before, **change})
+        self.adapter.update(p['area_id'], change)
+        after = self.adapter.area(p['area_id'])
+        expected = {**before, **change}
+        # Stable projection excludes timestamp changes, includes all untouched MVP metadata.
+        verified = after == expected
+        return result(r, 'SUCCESS' if verified else 'VERIFY_FAILED', before, after, verified)
+
+    def _floor(self, payload):
+        if payload.get('floor_id') is not None and not self.adapter.floor_exists(payload['floor_id']):
+            raise Invalid('Unknown Floor')
+
+    @staticmethod
+    def _change(payload):
+        change = dict(payload)
+        if 'name' in change:
+            change['name'] = change['name'].strip()
+        if 'aliases' in change:
+            change['aliases'] = sorted(set(a.strip() for a in (change['aliases'] or [])))
+        return change
+
+    @staticmethod
+    def _matches(area, change):
+        return area is not None and all(area.get(k) == v for k, v in change.items())
