diff --git a/codex-cli-worker/write_audit.py b/codex-cli-worker/write_audit.py
new file mode 100644
index 0000000..9bf96dc
--- /dev/null
+++ b/codex-cli-worker/write_audit.py
@@ -0,0 +1,47 @@
+"""Bounded audit output: fixed keys, no payloads/credentials or exception text."""
+import json
+import logging
+from logging.handlers import RotatingFileHandler
+from datetime import datetime, timezone
+from pathlib import Path
+import os
+
+class PrivateRotatingHandler(RotatingFileHandler):
+    def _open(self):
+        fd = os.open(self.baseFilename, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
+        return os.fdopen(fd, 'a', encoding='utf-8')
+
+class Audit:
+    def __init__(self, directory):
+        directory = Path(directory)
+        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+        path = directory / 'write-v1.jsonl'
+        fd = os.open(path, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
+        os.close(fd)
+        os.chmod(path, 0o600)
+        self.handler = PrivateRotatingHandler(path, maxBytes=1024*1024, backupCount=4, encoding='utf-8', delay=True)
+        self.handler.setFormatter(logging.Formatter('%(message)s'))
+
+    def emit(self, stage, request, outcome=None):
+        row = {'timestamp': datetime.now(timezone.utc).isoformat(), 'stage': stage,
+               **{k: request.get(k) for k in ('operation_id', 'task_id', 'turn_id', 'operation', 'scope', 'target')},
+               'result': outcome.get('status') if outcome else None,
+               'verified': outcome.get('verified', False) if outcome else False}
+        # Explicit emit/flush rather than logging.handleError (which can hide I/O failures).
+        encoded = json.dumps(row, ensure_ascii=False)
+        self.handler.acquire()
+        try:
+            if self.handler.stream is None:
+                self.handler.stream = self.handler._open()
+            record = logging.LogRecord('write-v1', logging.INFO, '', 0, encoded, (), None)
+            if self.handler.shouldRollover(record):
+                self.handler.doRollover()
+                if self.handler.stream is None:
+                    self.handler.stream = self.handler._open()
+            self.handler.stream.write(encoded + '\n')
+            self.handler.flush()
+        finally:
+            self.handler.release()
+
+    def close(self):
+        self.handler.close()
diff --git a/codex-cli-worker/write_broker.py b/codex-cli-worker/write_broker.py
new file mode 100644
index 0000000..6c3a890
--- /dev/null
+++ b/codex-cli-worker/write_broker.py
@@ -0,0 +1,80 @@
+"""Task-scoped, default-deny broker owned by the worker (never the model)."""
+import secrets
+import time
+from write_contract import SCOPES, PROTOCOL, validate, target_for, digest, signature, result, Denied, Invalid
+from write_audit import Audit
+
+class WriteBroker:
+    def __init__(self, worker, core_call, clock=time.time):
+        self.worker, self.core_call, self.clock = worker, core_call, clock
+        self.grants = {}
+        self.audit = None
+
+    def begin(self, task_id, turn_id, scopes):
+        if not isinstance(scopes, list) or set(scopes) - {'READ', 'WRITE_REGISTRY', 'WRITE_SERVICE'}:
+            raise ValueError('Invalid configured scopes')
+        self.grants[task_id] = (turn_id, frozenset(scopes))
+
+    def end(self, task_id):
+        self.grants.pop(task_id, None)
+
+    def execute(self, task_id, tool, payload, dry_run=False):
+        with self.worker.lock:
+            task = self.worker.tasks.get(task_id, {})
+            turn_id = task.get('current_turn_id')
+            grant = self.grants.get(task_id)
+            active = task.get('status') == 'running' and not self.worker.task_cancellation_requested(task_id)
+        r = {'protocol_version': PROTOCOL, 'operation_id': secrets.token_hex(16), 'task_id': task_id,
+             'turn_id': turn_id, 'operation': tool, 'scope': SCOPES.get(tool), 'target': None,
+             'payload': payload, 'dry_run': dry_run}
+        if not active or not grant or grant[0] != turn_id or SCOPES.get(tool) not in grant[1]:
+            return self.rejected(r, 'PERMISSION_DENIED')
+        try:
+            validate(tool, payload, dry_run)
+            r['target'] = target_for(tool, payload)
+        except Denied:
+            return self.rejected(r, 'PERMISSION_DENIED')
+        except (Invalid, TypeError):
+            return self.rejected(r, 'VALIDATION_ERROR')
+        secret = self.worker.api_token()
+        if not secret:
+            return self.rejected(r, 'PERMISSION_DENIED')
+        claims = {'task_id': task_id, 'turn_id': turn_id, 'operation_id': r['operation_id'],
+                  'allowed_operation': tool, 'allowed_target': r['target'], 'scope': r['scope'],
+                  'expiration': self.clock()+30, 'nonce': secrets.token_hex(16), 'request_digest': digest(r)}
+        proof = {'claims': claims, 'signature': signature(secret, claims)}
+        try:
+            if self.audit is None:
+                self.audit = Audit(self.worker.DATA_ROOT / 'write_audit')
+            self.audit.emit('START', r)
+        except Exception:
+            return result(r, 'WRITE_FAILED', warnings=['Worker audit unavailable; request not sent'])
+        try:
+            # Fixed endpoint, credentials added inside the existing trusted core() helper.
+            response = self.core_call('POST', 'codex_cli/write_operation', json={**r, 'authorization': proof})
+            if not isinstance(response, dict) or response.get('operation_id') != r['operation_id'] or response.get('tool') != tool or response.get('target') != r['target']:
+                response = result(r, 'VERIFY_FAILED', warnings=['Backend response mismatch'])
+            # Project only contract fields. Never forward backend credentials/exception details.
+            allowed = set(result(r, 'SUCCESS'))
+            response = {k: v for k, v in response.items() if k in allowed}
+            response = self.worker.redact_json_result(response) if hasattr(self.worker, 'redact_json_result') else response
+        except Exception:
+            response = result(r, 'WRITE_FAILED', warnings=['Backend unavailable; execution outcome unknown; do not retry blindly'])
+        try:
+            self.audit.emit('RESULT', r, response)
+        except Exception:
+            return result(r, 'VERIFY_FAILED', warnings=['Worker result audit failed; execution may have occurred'])
+        return response
+
+    def rejected(self, request, status):
+        outcome = result(request, status)
+        safe = {k: request.get(k) for k in ('operation_id', 'task_id', 'turn_id')}
+        safe['operation'] = request['operation'] if request['operation'] in SCOPES else 'rejected_request'
+        try:
+            if self.audit is None:
+                self.audit = Audit(self.worker.DATA_ROOT / 'write_audit')
+            self.audit.emit('START', safe)
+            self.audit.emit('RESULT', safe, outcome)
+        except Exception:
+            pass  # Failure cannot change the denial into an allowed operation.
+        return outcome
diff --git a/codex-cli-worker/write_contract.py b/codex-cli-worker/write_contract.py
new file mode 100644
index 0000000..56297ed
--- /dev/null
+++ b/codex-cli-worker/write_contract.py
@@ -0,0 +1,144 @@
+"""Strict MVP wire contract; shared verbatim with the trusted worker."""
+import hashlib
+import hmac
+import json
+import re
+import unicodedata
+
+PROTOCOL = 1
+SCOPES = {
+    'ha_area_create': 'WRITE_REGISTRY',
+    'ha_area_update': 'WRITE_REGISTRY',
+    'ha_area_get_environment_entities': 'READ',
+    'ha_area_set_temperature_entity': 'WRITE_REGISTRY',
+    'ha_service_call': 'WRITE_SERVICE',
+}
+FIELDS = {
+    'ha_area_create': ({'name'}, {'name', 'floor_id', 'icon', 'aliases'}),
+    'ha_area_update': ({'area_id'}, {'area_id', 'name', 'floor_id', 'icon', 'aliases'}),
+    'ha_area_get_environment_entities': ({'area_id'}, {'area_id'}),
+    'ha_area_set_temperature_entity': ({'area_id', 'entity_id'}, {'area_id', 'entity_id'}),
+    'ha_service_call': ({'domain', 'service', 'target'}, {'domain', 'service', 'target', 'data'}),
+}
+
+class Invalid(ValueError):
+    """Input cannot be executed."""
+
+class Denied(ValueError):
+    """Authorization cannot be accepted."""
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False).encode()
+
+def normalized(name):
+    return ' '.join(unicodedata.normalize('NFKC', name).split()).casefold()
+
+def text(value):
+    if not isinstance(value, str) or not value.strip() or len(value) > 128 or any(ord(c) < 32 for c in value):
+        raise Invalid('Invalid bounded string')
+
+def identifier(value):
+    if not isinstance(value, str) or not re.fullmatch(r'[a-z0-9_]{1,128}', value):
+        raise Invalid('Invalid registry identifier')
+
+def validate(operation, payload, dry_run):
+    if operation not in SCOPES:
+        raise Denied('Unknown operation')
+    if not isinstance(payload, dict) or type(dry_run) is not bool:
+        raise Invalid('Invalid request shape')
+    required, allowed = FIELDS[operation]
+    if required - payload.keys() or payload.keys() - allowed:
+        raise Invalid('Missing or forbidden fields')
+    if 'name' in payload:
+        text(payload['name'])
+    for key in ('area_id', 'floor_id'):
+        if key in payload and not (key == 'floor_id' and payload[key] is None):
+            identifier(payload[key])
+    if 'icon' in payload and payload['icon'] is not None:
+        if not isinstance(payload['icon'], str) or not re.fullmatch(r'mdi:[a-z0-9-]{1,80}', payload['icon']):
+            raise Invalid('Invalid icon')
+    if 'aliases' in payload and payload['aliases'] is not None:
+        if not isinstance(payload['aliases'], list) or len(payload['aliases']) > 32:
+            raise Invalid('Invalid aliases')
+        for alias in payload['aliases']:
+            text(alias)
+    if 'entity_id' in payload:
+        if not isinstance(payload['entity_id'], str) or not re.fullmatch(r'sensor\.[a-z0-9_]{1,128}', payload['entity_id']):
+            raise Invalid('Invalid sensor entity')
+    if operation == 'ha_service_call':
+        if (payload['domain'], payload['service']) != ('update', 'install'):
+            raise Denied('Service is not allowlisted')
+        if payload['target'] != {'entity_id': 'update.codex_update'}:
+            raise Denied('Target is not allowlisted')
+        data = payload.get('data', {})
+        if not isinstance(data, dict) or set(data) - {'version'}:
+            raise Invalid('Forbidden service data')
+        # Pin MVP to the approved upstream build; cannot install a future/unreviewed version.
+        if data.get('version', '0.1.70') not in ('0.1.70', 'v0.1.70'):
+            raise Denied('Version is not allowlisted')
+
+def target_for(operation, payload):
+    if operation == 'ha_area_create':
+        return {'normalized_name': normalized(payload['name'])}
+    if operation == 'ha_service_call':
+        return {'entity_id': 'update.codex_update'}
+    return {'area_id': payload['area_id']}
+
+REQUEST_KEYS = {'protocol_version', 'operation_id', 'task_id', 'turn_id', 'operation', 'scope', 'target', 'payload', 'dry_run'}
+
+def digest(request):
+    return hashlib.sha256(canonical(request)).hexdigest()
+
+def signature(secret, claims):
+    key = hmac.new(secret.encode(), b'codex-cli/write-v1', hashlib.sha256).digest()
+    return hmac.new(key, canonical(claims), hashlib.sha256).hexdigest()
+
+def authorize(request, proof, secret, now, seen):
+    if set(request) != REQUEST_KEYS or request.get('protocol_version') != PROTOCOL:
+        raise Invalid('Unsupported protocol or request shape')
+    validate(request['operation'], request['payload'], request['dry_run'])
+    for key in ('task_id', 'turn_id', 'operation_id'):
+        text(request[key])
+    if request['scope'] != SCOPES[request['operation']] or request['target'] != target_for(request['operation'], request['payload']):
+        raise Denied('Scope or target mismatch')
+    expected = {'task_id', 'turn_id', 'operation_id', 'allowed_operation', 'allowed_target', 'scope', 'expiration', 'nonce', 'request_digest'}
+    if not isinstance(proof, dict) or set(proof) != {'claims', 'signature'}:
+        raise Denied('Missing authorization')
+    claims = proof['claims']
+    if not isinstance(claims, dict) or set(claims) != expected:
+        raise Denied('Invalid authorization shape')
+    try:
+        valid_signature = hmac.compare_digest(signature(secret, claims), proof['signature'])
+    except (TypeError, ValueError):
+        raise Denied('Invalid authorization') from None
+    if not valid_signature:
+        raise Denied('Invalid authorization')
+    expiration = claims['expiration']
+    if type(expiration) not in (int, float) or not now < expiration <= now + 60:
+        raise Denied('Expired or excessive authorization lifetime')
+    checks = {'task_id': request['task_id'], 'turn_id': request['turn_id'], 'operation_id': request['operation_id'],
+              'allowed_operation': request['operation'], 'allowed_target': request['target'],
+              'scope': request['scope'], 'request_digest': digest(request)}
+    if any(claims[k] != v for k, v in checks.items()):
+        raise Denied('Authorization binding mismatch')
+    nonce = claims['nonce']
+    if not isinstance(nonce, str) or not re.fullmatch(r'[a-f0-9]{32}', nonce):
+        raise Denied('Invalid nonce')
+    for n, exp in list(seen.items()):
+        if exp <= now:
+            del seen[n]
+    if nonce in seen or len(seen) >= 4096:
+        raise Denied('Replay or authorization capacity exceeded')
+    seen[nonce] = expiration
+
+def result(request, status, before=None, after=None, verified=False, warnings=None):
+    # Never echo unvalidated attacker-controlled fields, even on error paths.
+    try:
+        validate(request.get('operation'), request.get('payload'), request.get('dry_run'))
+        safe_target = target_for(request['operation'], request['payload'])
+        safe_requested = request['payload']
+    except (Invalid, Denied, TypeError, KeyError):
+        safe_target, safe_requested = None, None
+    return {'status': status, 'operation_id': request.get('operation_id'), 'tool': request.get('operation'),
+            'target': safe_target, 'before': before, 'requested': safe_requested,
+            'after': after, 'verified': verified, 'restart_required': False, 'warnings': warnings or []}
diff --git a/codex-cli-worker/write_mcp.py b/codex-cli-worker/write_mcp.py
