+"""No HA imports, sockets, service calls or production file writes."""
+import asyncio
+import copy
+import importlib
+import json
+from pathlib import Path
+import secrets
+import sys
+import tempfile
+import threading
+import types
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+pkg = types.ModuleType('isolated_codex')
+pkg.__path__ = [str(ROOT / 'custom_components/codex_cli')]
+sys.modules['isolated_codex'] = pkg
+C = importlib.import_module('isolated_codex.write_contract')
+Backend = importlib.import_module('isolated_codex.write_backend').Backend
+Audit = importlib.import_module('isolated_codex.write_audit').Audit
+ReplayGuard = importlib.import_module('isolated_codex.write_auth').ReplayGuard
+sys.path.insert(0, str(ROOT / 'codex-cli-worker'))
+from write_broker import WriteBroker
+
+SECRET = 'isolated-test-secret-do-not-use-in-production'
+NOW = 1000
+
+def envelope(operation, payload, dry=False):
+    r = {'protocol_version': 1, 'operation_id': secrets.token_hex(16), 'task_id': 'test-task',
+         'turn_id': 'test-turn', 'operation': operation, 'scope': C.SCOPES.get(operation, 'READ'),
+         'target': C.target_for(operation, payload) if operation in C.SCOPES else {},
+         'payload': payload, 'dry_run': dry}
+    claims = {'task_id': r['task_id'], 'turn_id': r['turn_id'], 'operation_id': r['operation_id'],
+              'allowed_operation': operation, 'allowed_target': r['target'], 'scope': r['scope'],
+              'expiration': NOW+30, 'nonce': secrets.token_hex(16), 'request_digest': C.digest(r)}
+    return r, {'claims': claims, 'signature': C.signature(SECRET, claims)}
+
+class MemoryAudit:
+    def __init__(self): self.rows = []
+    def emit(self, *args): self.rows.append(args)
+
+class FakeAdapter:
+    def __init__(self):
+        self.items = {'kitchen': {'area_id': 'kitchen', 'name': 'Kuchyňa', 'floor_id': None,
+                                  'icon': None, 'aliases': [], 'temperature_entity_id': 'sensor.old',
+                                  'humidity_entity_id': 'sensor.humidity', 'picture': None, 'labels': []}}
+        self.entities = [{'entity_id': 'sensor.room_temperature', 'device_class': 'temperature',
+                          'unit': '°C', 'diagnostic': False}]
+        self.installed = 'v0.1.70'; self.latest = 'v0.1.70'
+        self.calls = []; self.bad_readback = False
+    def areas(self): return copy.deepcopy(list(self.items.values()))
+    def area(self, key): return copy.deepcopy(self.items.get(key))
+    def floor_exists(self, key): return key in ('prizemie', 'poschodie')
+    def create(self, change):
+        key = 'created'
+        self.items[key] = {'area_id': key, 'floor_id': None, 'icon': None, 'aliases': [],
+                           'temperature_entity_id': None, 'humidity_entity_id': None,
+                           'picture': None, 'labels': [], **change}
+        self.calls.append(('create', change))
+        return key
+    def update(self, key, change):
+        self.calls.append(('update', key, change))
+        if not self.bad_readback: self.items[key].update(change)
+    def candidates(self, area_id): return copy.deepcopy(self.entities) if area_id == 'kitchen' else []
+    def update_state(self): return {'installed_version': self.installed, 'latest_version': self.latest}
+    async def install_update(self, version): self.calls.append(('install', version)); self.installed = version
+
+class Operations(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.adapter = FakeAdapter(); self.audit = MemoryAudit()
+        self.backend = Backend(self.adapter, SECRET, self.audit, lambda: NOW)
+    async def call(self, op, payload, dry=False):
+        r, p = envelope(op, payload, dry); return await self.backend.execute(r, p)
+    async def test_create(self):
+        x = await self.call('ha_area_create', {'name': 'WC dole', 'floor_id': 'prizemie'})
+        self.assertEqual(x['status'], 'SUCCESS'); self.assertTrue(x['verified'])
+        self.assertEqual([r[0] for r in self.audit.rows], ['START', 'RESULT'])
+    async def test_normalized_duplicate(self):
+        x = await self.call('ha_area_create', {'name': '  KUCHYŇA  '})
+        self.assertEqual(x['status'], 'ALREADY_EXISTS'); self.assertFalse(self.adapter.calls)
+    async def test_update_name(self):
+        self.assertEqual((await self.call('ha_area_update', {'area_id':'kitchen','name':'Kitchen'}))['status'],'SUCCESS')
+    async def test_set_floor(self):
+        x = await self.call('ha_area_update', {'area_id':'kitchen','floor_id':'prizemie'})
+        self.assertEqual(x['after']['floor_id'],'prizemie'); self.assertEqual(x['after']['humidity_entity_id'],'sensor.humidity')
+    async def test_remove_floor(self):
+        self.adapter.items['kitchen']['floor_id']='prizemie'
+        x = await self.call('ha_area_update', {'area_id':'kitchen','floor_id':None})
+        self.assertIsNone(x['after']['floor_id'])
+    async def test_omitted_floor_unchanged(self):
+        self.adapter.items['kitchen']['floor_id']='prizemie'
+        x = await self.call('ha_area_update', {'area_id':'kitchen','icon':'mdi:home'})
+        self.assertEqual(x['after']['floor_id'],'prizemie')
+    async def test_unknown_area(self):
+        self.assertEqual((await self.call('ha_area_update', {'area_id':'missing'}))['status'],'VALIDATION_ERROR')
+    async def test_unknown_floor(self):
+        self.assertEqual((await self.call('ha_area_create', {'name':'New','floor_id':'missing'}))['status'],'VALIDATION_ERROR')
+    async def test_create_dry_run(self):
+        self.assertEqual((await self.call('ha_area_create', {'name':'New'}, True))['status'],'DRY_RUN');self.assertFalse(self.adapter.calls)
+    async def test_update_dry_run(self):
+        self.assertEqual((await self.call('ha_area_update', {'area_id':'kitchen','floor_id':'prizemie'}, True))['status'],'DRY_RUN');self.assertFalse(self.adapter.calls)
+    async def test_idempotency(self):
+        p={'area_id':'kitchen','floor_id':'prizemie'}
+        await self.call('ha_area_update',p)
+        self.assertEqual((await self.call('ha_area_update',p))['status'],'NO_CHANGE');self.assertEqual(len(self.adapter.calls),1)
+    async def test_verification_failure(self):
+        self.adapter.bad_readback=True
+        self.assertEqual((await self.call('ha_area_update',{'area_id':'kitchen','floor_id':'prizemie'}))['status'],'VERIFY_FAILED')
+    async def test_valid_temperature(self):
+        x=await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.room_temperature'})
+        self.assertEqual(x['status'],'SUCCESS');self.assertEqual(x['before']['temperature_entity_id'],'sensor.old')
+    async def test_device_temperature(self):
+        self.adapter.entities[0]['entity_id']='sensor.room_device_temperature'
+        self.assertEqual((await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.room_device_temperature'}))['status'],'VALIDATION_ERROR')
+    async def test_diagnostic_temperature(self):
+        self.adapter.entities[0]['diagnostic']=True
+        self.assertEqual((await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.room_temperature'}))['status'],'VALIDATION_ERROR')
+    async def test_non_temperature(self):
+        self.adapter.entities[0]['device_class']='humidity'
+        self.assertEqual((await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.room_temperature'}))['status'],'VALIDATION_ERROR')
+    async def test_wrong_area(self):
+        self.adapter.entities=[]
+        self.assertEqual((await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.room_temperature'}))['status'],'VALIDATION_ERROR')
+    async def test_missing_entity(self):
+        self.assertEqual((await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.missing'}))['status'],'VALIDATION_ERROR')
+    async def test_wrong_unit(self):
+        self.adapter.entities[0]['unit']='hPa'
+        self.assertEqual((await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.room_temperature'}))['status'],'VALIDATION_ERROR')
+    async def test_temperature_dry_run(self):
+        self.assertEqual((await self.call('ha_area_set_temperature_entity',{'area_id':'kitchen','entity_id':'sensor.room_temperature'},True))['status'],'DRY_RUN');self.assertFalse(self.adapter.calls)
+    async def test_environment_read(self):
+        self.assertTrue((await self.call('ha_area_get_environment_entities',{'area_id':'kitchen'}))['verified']);self.assertFalse(self.adapter.calls)
+    def service(self): return {'domain':'update','service':'install','target':{'entity_id':'update.codex_update'}}
+    async def test_update_already_current(self):
+        self.assertEqual((await self.call('ha_service_call',self.service()))['status'],'NO_CHANGE');self.assertFalse(self.adapter.calls)
+    async def test_update_install(self):
+        self.adapter.installed='v0.1.69'
+        self.assertEqual((await self.call('ha_service_call',self.service()))['status'],'SUCCESS');self.assertEqual(len(self.adapter.calls),1)
+    async def test_update_dry_run(self):
+        self.adapter.installed='v0.1.69'
+        self.assertEqual((await self.call('ha_service_call',self.service(),True))['status'],'DRY_RUN');self.assertFalse(self.adapter.calls)
+    async def test_unsupported_update_target(self):
+        p=self.service();p['target']['entity_id']='update.firmware'
+        self.assertEqual((await self.call('ha_service_call',p))['status'],'PERMISSION_DENIED')
+    async def test_unsupported_service(self):
+        p=self.service();p['domain']='mqtt';p['service']='publish'
+        self.assertEqual((await self.call('ha_service_call',p))['status'],'PERMISSION_DENIED')
+    async def test_future_version_denied(self):
+        p=self.service();p['data']={'version':'0.1.71'}
+        self.assertEqual((await self.call('ha_service_call',p))['status'],'PERMISSION_DENIED')
+    async def test_secret_not_echoed(self):
+        p=self.service();p['data']={'token':'SENSITIVE_SENTINEL'}
+        out=await self.call('ha_service_call',p)
+        self.assertNotIn('SENSITIVE_SENTINEL',json.dumps(out))
+
+class Security(unittest.TestCase):
+    def setUp(self): self.r,self.proof=envelope('ha_area_update',{'area_id':'kitchen','floor_id':'prizemie'});self.seen={}
+    def check(self): C.authorize(self.r,self.proof,SECRET,NOW,self.seen)
+    def resign(self): self.proof['signature']=C.signature(SECRET,self.proof['claims'])
+    def test_expired(self):
+        self.proof['claims']['expiration']=NOW;self.resign()
+        with self.assertRaises(C.Denied):self.check()
+    def test_bad_digest(self):
+        self.r['payload']['floor_id']=None
+        with self.assertRaises(C.Denied):self.check()
+    def test_replay(self):
+        self.check()
+        with self.assertRaises(C.Denied):self.check()
+    def test_wrong_task(self):
+        self.r['task_id']='other'
+        with self.assertRaises(C.Denied):self.check()
+    def test_wrong_turn(self):
+        self.r['turn_id']='other'
+        with self.assertRaises(C.Denied):self.check()
+    def test_scope_escalation(self):
+        self.r['scope']='SYSTEM_RESTART'
+        with self.assertRaises(C.Denied):self.check()
+    def test_bad_signature(self):
+        self.proof['signature']='f'*64
+        with self.assertRaises(C.Denied):self.check()
+    def test_unknown_operation(self):
+        self.r['operation']='ha_core_restart'
+        with self.assertRaises(C.Denied):self.check()
+    def test_ws_injection(self):
+        self.r['payload']['websocket_command']='config/area_registry/delete'
+        with self.assertRaises(C.Invalid):self.check()
+    def test_url_path_injection(self):
+        for field in ('url','path','method','python'):
+            with self.subTest(field=field):
+                p={'area_id':'kitchen',field:'../../.storage/auth'}
+                with self.assertRaises(C.Invalid):C.validate('ha_area_update',p,False)
+    def test_read_scope(self):
+        self.r['scope']='READ'
+        with self.assertRaises(C.Denied):self.check()
+    def test_replay_survives_new_backend(self):
+        with tempfile.TemporaryDirectory() as d:
+            self.seen=ReplayGuard(d,lambda:NOW);self.check()
+            self.seen=ReplayGuard(d,lambda:NOW)
+            with self.assertRaises(C.Denied):self.check()
+    def test_audit_bounded_and_private(self):
+        with tempfile.TemporaryDirectory() as d:
+            a=Audit(d);a.handler.maxBytes=250
+            for _ in range(40):a.emit('START',self.r)
+            a.close();files=list(Path(d).glob('write-v1*'))
+            self.assertLessEqual(len(files),5)
+            self.assertNotIn(SECRET,''.join(p.read_text() for p in files))
+            self.assertEqual(Path(d,'write-v1.jsonl').stat().st_mode&0o777,0o600)
+
+class WorkerTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup)
+        self.worker=types.SimpleNamespace(lock=threading.RLock(),tasks={'test-task':{'current_turn_id':'test-turn','status':'running'}},
+                                         task_cancellation_requested=lambda t:False,api_token=lambda:SECRET,DATA_ROOT=Path(self.tmp.name))
+        self.sent=[]
+        def core(method,path,**kwargs):
+            self.sent.append((method,path,kwargs));r=kwargs['json'];return C.result(r,'DRY_RUN')
+        self.broker=WriteBroker(self.worker,core,lambda:NOW)
+    def test_read_only_grant_denied(self):
+        self.broker.begin('test-task','test-turn',['READ'])
+        self.assertEqual(self.broker.execute('test-task','ha_area_create',{'name':'New'})['status'],'PERMISSION_DENIED');self.assertFalse(self.sent)
+    def test_missing_scope(self):
+        self.assertEqual(self.broker.execute('test-task','ha_service_call',{'domain':'update','service':'install','target':{'entity_id':'update.codex_update'}})['status'],'PERMISSION_DENIED')
+    def test_signed_fixed_endpoint(self):
