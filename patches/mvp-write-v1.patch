+"""HA endpoint wiring tests with module stubs, never a production HA process."""
+import importlib
+import json
+import sys
+import types
+import unittest
+from test_write_v1 import ROOT, SECRET, envelope, Backend, FakeAdapter, MemoryAudit, NOW
+
+class HttpError(Exception): pass
+class View:
+    def json(self, data, **kwargs): return data
+
+def module(name, **attrs):
+    m=types.ModuleType(name);m.__path__=[]
+    for key,value in attrs.items():setattr(m,key,value)
+    sys.modules[name]=m
+    return m
+
+module('aiohttp',web=types.SimpleNamespace(HTTPServiceUnavailable=HttpError,HTTPForbidden=HttpError,
+                                         HTTPBadRequest=HttpError,HTTPRequestEntityTooLarge=lambda **kw:HttpError()))
+module('homeassistant')
+module('homeassistant.components')
+module('homeassistant.components.http',HomeAssistantView=View)
+module('homeassistant.components.http.const',KEY_HASS_USER='ha_user')
+module('homeassistant.const',__version__='2026.9.4')
+helpers=module('homeassistant.helpers')
+for name in ('area_registry','floor_registry','entity_registry','device_registry'):
+    setattr(helpers,name,module('homeassistant.helpers.'+name))
+module('isolated_codex.const',DOMAIN='codex_cli')
+api=importlib.import_module('isolated_codex.write_api')
+
+class Content:
+    def __init__(self,data):self.data=data
+    async def iter_chunked(self,n):
+        for i in range(0,len(self.data),n):yield self.data[i:i+n]
+
+class Request(dict):
+    def __init__(self,body,admin=True):
+        super().__init__({'ha_user':types.SimpleNamespace(is_admin=admin)})
+        self.content=Content(json.dumps(body).encode())
+
+class EndpointTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.adapter=FakeAdapter();self.backend=Backend(self.adapter,SECRET,MemoryAudit(),lambda:NOW)
+        self.hass=types.SimpleNamespace(data={'codex_cli':{'write_backend':self.backend}})
+        self.view=api.WriteOperationView(self.hass)
+        r,proof=envelope('ha_area_create',{'name':'WC dole'},True)
+        self.body={**r,'authorization':proof,'worker_token':SECRET}
+    async def test_paired_admin_dry_run(self):
+        out=await self.view.post(Request(self.body))
+        self.assertEqual(out['status'],'DRY_RUN');self.assertFalse(self.adapter.calls)
+        self.assertNotIn(SECRET,json.dumps(out))
+    async def test_non_admin_denied(self):
+        with self.assertRaises(HttpError):await self.view.post(Request(self.body,False))
+        self.assertFalse(self.adapter.calls)
+    async def test_pairing_secret_denied(self):
+        self.body['worker_token']='wrong'
+        with self.assertRaises(HttpError):await self.view.post(Request(self.body))
+    async def test_no_backend_denied(self):
+        self.hass.data={}
+        with self.assertRaises(HttpError):await self.view.post(Request(self.body))
+    async def test_arbitrary_url_denied(self):
+        self.body['url']='http://untrusted.invalid'
+        with self.assertRaises(HttpError):await self.view.post(Request(self.body))
+    async def test_large_body_denied(self):
+        self.body['extra']='x'*20000
+        with self.assertRaises(HttpError):await self.view.post(Request(self.body))
+    async def test_bad_proof_denied(self):
+        self.body['authorization']['signature']='0'*64
+        self.assertEqual((await self.view.post(Request(self.body)))['status'],'PERMISSION_DENIED')
+
+class AdapterTests(unittest.IsolatedAsyncioTestCase):
+    async def test_service_signature(self):
+        calls=[]
+        async def async_call(*args,**kwargs):calls.append((args,kwargs))
+        adapter=object.__new__(api.HAAdapter)
+        adapter.hass=types.SimpleNamespace(services=types.SimpleNamespace(async_call=async_call))
+        await adapter.install_update('v0.1.70')
+        self.assertEqual(calls,[(('update','install',{'version':'v0.1.70'}),{'blocking':True,'target':{'entity_id':'update.codex_update'}})])
+    async def test_unsupported_core_version(self):
+        previous=api.HA_VERSION
+        try:
+            api.HA_VERSION='2026.9.5'
+            with self.assertRaises(ValueError):api.HAAdapter(types.SimpleNamespace())
+        finally:api.HA_VERSION=previous
+
+class MCPTests(unittest.TestCase):
+    def test_tool_discovery(self):
+        m=importlib.import_module('verification_mcp')
+        tools=m.respond({'method':'tools/list'})['tools']
+        self.assertEqual({t['name'] for t in tools},{'verify','ha_area_create','ha_area_update','ha_area_get_environment_entities','ha_area_set_temperature_entity','ha_service_call'})
+        for tool in tools:
+            self.assertFalse(tool['inputSchema']['additionalProperties'])
+            self.assertNotIn('scope',tool['inputSchema']['properties'])
+    def test_read_tools_preserved(self):
+        m=importlib.import_module('verification_mcp')
