@@ -0,0 +1,139 @@
+"""Fixed HA adapter and admin/paired-worker endpoint; no generic proxy."""
+import hmac
+import json
+import logging
+from aiohttp import web
+from homeassistant.components.http import HomeAssistantView
+from homeassistant.components.http.const import KEY_HASS_USER
+from homeassistant.const import __version__ as HA_VERSION
+from homeassistant.helpers import area_registry as ar, floor_registry as fr, entity_registry as er, device_registry as dr
+from .const import DOMAIN
+from .write_backend import Backend
+from .write_audit import Audit
+from .write_auth import ReplayGuard
+from .write_contract import REQUEST_KEYS, result
+
+class HAAdapter:
+    def __init__(self, hass):
+        if HA_VERSION != '2026.9.4':
+            raise ValueError('MVP backend supports only tested Core 2026.9.4')
+        self.hass = hass
+        self.ar, self.fr, self.er, self.dr = ar.async_get(hass), fr.async_get(hass), er.async_get(hass), dr.async_get(hass)
+
+    @staticmethod
+    def serialize(entry):
+        if entry is None:
+            return None
+        return {'area_id': entry.id, 'name': entry.name, 'floor_id': entry.floor_id,
+                'icon': entry.icon, 'aliases': sorted(entry.aliases),
+                'temperature_entity_id': entry.temperature_entity_id,
+                'humidity_entity_id': entry.humidity_entity_id,
+                'picture': entry.picture, 'labels': sorted(entry.labels)}
+
+    def areas(self):
+        return [self.serialize(a) for a in self.ar.async_list_areas()]
+
+    def area(self, area_id):
+        return self.serialize(self.ar.async_get_area(area_id))
+
+    def floor_exists(self, floor_id):
+        return self.fr.async_get_floor(floor_id) is not None
+
+    @staticmethod
+    def kwargs(change):
+        return {k: set(v) if k == 'aliases' else v for k, v in change.items()}
+
+    def create(self, change):
+        return self.ar.async_create(**self.kwargs(change)).id
+
+    def update(self, area_id, change):
+        self.ar.async_update(area_id, **self.kwargs(change))
+
+    def candidates(self, area_id):
+        candidates = []
+        for entry in self.er.entities.values():
+            effective = er.async_get_effective_area_id(self.hass, entry)
+            if effective != area_id:
+                continue
+            state = self.hass.states.get(entry.entity_id)
+            if state is None or not entry.entity_id.startswith('sensor.'):
+                continue
+            attrs = state.attributes
+            device_class = attrs.get('device_class')
+            if device_class not in ('temperature', 'humidity', 'atmospheric_pressure', 'illuminance', 'carbon_dioxide', 'pm25', 'pm10'):
+                continue
+            device = self.dr.async_get(entry.device_id) if entry.device_id else None
+            candidates.append({'entity_id': entry.entity_id, 'device_id': entry.device_id,
+                               'device_class': device_class, 'state_class': attrs.get('state_class'),
+                               'unit': attrs.get('unit_of_measurement'), 'entity_category': entry.entity_category,
+                               'area': effective, 'entity_area': entry.area_id,
+                               'device_area': dr.async_get_effective_area_id(self.hass, device) if device else None,
+                               'diagnostic': entry.entity_category == 'diagnostic' or 'device_temperature' in entry.entity_id,
+                               'state_available': state.state not in ('unknown', 'unavailable')})
+        return candidates
+
+    def update_state(self):
+        entry = self.er.async_get('update.codex_update')
+        # Do not act on a renamed/spoofed update entity belonging to another integration.
+        if entry is None or entry.platform != 'hacs' or entry.unique_id != '1251200641':
+            return None
+        state = self.hass.states.get('update.codex_update')
+        if state is None or state.state not in ('on', 'off'):
+            return None
+        return {k: state.attributes.get(k) for k in ('installed_version', 'latest_version')}
+
+    async def install_update(self, version):
+        await self.hass.services.async_call('update', 'install', {'version': version}, blocking=True,
+                                            target={'entity_id': 'update.codex_update'})
+
+class WriteOperationView(HomeAssistantView):
+    url = '/api/codex_cli/write_operation'
+    name = 'api:codex_cli:write_operation'
+    requires_auth = True
+
+    def __init__(self, hass):
+        self.hass = hass
+
+    async def post(self, request):
+        user = request.get(KEY_HASS_USER)
+        backend = self.hass.data.get(DOMAIN, {}).get('write_backend')
+        if backend is None:
+            raise web.HTTPServiceUnavailable()
+        if user is None or not user.is_admin:
+            raise web.HTTPForbidden()
+        raw = bytearray()
+        async for chunk in request.content.iter_chunked(1024):
+            raw.extend(chunk)
+            if len(raw) > 16384:
+                raise web.HTTPRequestEntityTooLarge(max_size=16384, actual_size=len(raw))
+        try:
+            body = json.loads(raw)
+        except (ValueError, UnicodeError):
+            raise web.HTTPBadRequest() from None
+        if not isinstance(body, dict) or set(body) != REQUEST_KEYS | {'authorization', 'worker_token'}:
+            raise web.HTTPBadRequest()
+        token = body.pop('worker_token')
+        if not isinstance(token, str) or not hmac.compare_digest(token.encode(), backend.secret.encode()):
+            raise web.HTTPForbidden()
+        proof = body.pop('authorization')
+        outcome = await backend.execute(body, proof)
+        return self.json(outcome, headers={'Cache-Control': 'no-store'})
+
+def setup_backend(hass, secret):
+    audit = None
+    try:
+        adapter = HAAdapter(hass)
+        audit = Audit(hass.config.path('codex_write_audit'))
+        backend = Backend(adapter, secret, audit)
+        backend.seen = ReplayGuard(hass.config.path('codex_write_audit'))
+    except Exception:
+        if audit is not None:
+            audit.close()
+        # Write extension unavailable must not break the existing read/pairing integration.
+        logging.getLogger(__name__).warning('MVP write backend unavailable; existing read integration remains enabled')
+        return lambda: None
+    hass.data.setdefault(DOMAIN, {})['write_backend'] = backend
+    def close():
+        hass.data[DOMAIN].pop('write_backend', None)
+        audit.close()
+    return close
