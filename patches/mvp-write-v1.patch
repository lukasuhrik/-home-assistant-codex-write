+++ b/codex-cli-worker/write_mcp.py
@@ -0,0 +1,24 @@
+"""MVP schemas: caller cannot supply authorization, scope, URL or raw command."""
+from write_contract import SCOPES
+
+def obj(properties, required=()):
+    return {'type': 'object', 'properties': properties, 'required': list(required), 'additionalProperties': False}
+
+S = {'type': 'string'}
+NULLABLE = {'type': ['string', 'null']}
+COMMON = {'dry_run': {'type': 'boolean', 'default': False}}
+META = {'name': S, 'floor_id': NULLABLE, 'icon': NULLABLE,
+        'aliases': {'type': ['array', 'null'], 'items': S, 'maxItems': 32}}
+SCHEMAS = {
+    'ha_area_create': obj({**META, **COMMON}, ['name']),
+    'ha_area_update': obj({'area_id': S, **META, **COMMON}, ['area_id']),
+    'ha_area_get_environment_entities': obj({'area_id': S}, ['area_id']),
+    'ha_area_set_temperature_entity': obj({'area_id': S, 'entity_id': S, **COMMON}, ['area_id', 'entity_id']),
+    'ha_service_call': obj({'domain': {'const': 'update', 'type': 'string'},
+                            'service': {'const': 'install', 'type': 'string'},
+                            'target': obj({'entity_id': {'const': 'update.codex_update', 'type': 'string'}}, ['entity_id']),
+                            'data': obj({'version': {'type': 'string', 'enum': ['0.1.70', 'v0.1.70']}}), **COMMON},
+                           ['domain', 'service', 'target']),
+}
+TOOLS = [{'name': name, 'description': f'MVP fixed operation; requires {SCOPES[name]}. Dry run never mutates HA.',
+          'inputSchema': schema} for name, schema in SCHEMAS.items()]
