@@ -0,0 +1,47 @@
+"""Bounded audit output: fixed keys, no payloads/credentials or exception text."""
+import json
+import logging
+from logging.handlers import RotatingFileHandler
+from datetime import datetime, timezone
+from pathlib import Path
+import os
+
+class PrivateRotatingHandler(RotatingFileHandler):
+    def _open(self):
+        fd = os.open(self.baseFilename, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
+        return os.fdopen(fd, 'a', encoding='utf-8')
+
+class Audit:
+    def __init__(self, directory):
+        directory = Path(directory)
+        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+        path = directory / 'write-v1.jsonl'
+        fd = os.open(path, os.O_CREAT | os.O_APPEND | os.O_WRONLY, 0o600)
+        os.close(fd)
+        os.chmod(path, 0o600)
+        self.handler = PrivateRotatingHandler(path, maxBytes=1024*1024, backupCount=4, encoding='utf-8', delay=True)
+        self.handler.setFormatter(logging.Formatter('%(message)s'))
+
+    def emit(self, stage, request, outcome=None):
+        row = {'timestamp': datetime.now(timezone.utc).isoformat(), 'stage': stage,
+               **{k: request.get(k) for k in ('operation_id', 'task_id', 'turn_id', 'operation', 'scope', 'target')},
+               'result': outcome.get('status') if outcome else None,
+               'verified': outcome.get('verified', False) if outcome else False}
+        # Explicit emit/flush rather than logging.handleError (which can hide I/O failures).
+        encoded = json.dumps(row, ensure_ascii=False)
+        self.handler.acquire()
+        try:
+            if self.handler.stream is None:
+                self.handler.stream = self.handler._open()
+            record = logging.LogRecord('write-v1', logging.INFO, '', 0, encoded, (), None)
+            if self.handler.shouldRollover(record):
+                self.handler.doRollover()
+                if self.handler.stream is None:
+                    self.handler.stream = self.handler._open()
+            self.handler.stream.write(encoded + '\n')
+            self.handler.flush()
+        finally:
+            self.handler.release()
+
+    def close(self):
+        self.handler.close()
