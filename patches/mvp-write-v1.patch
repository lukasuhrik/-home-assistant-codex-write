+++ b/custom_components/codex_cli/write_contract.py
@@ -0,0 +1,144 @@
+"""Strict MVP wire contract; shared verbatim with the trusted worker."""
+import hashlib
+import hmac
+import json
+import re
+import unicodedata
+
+PROTOCOL = 1
+SCOPES = {
+    'ha_area_create': 'WRITE_REGISTRY',
+    'ha_area_update': 'WRITE_REGISTRY',
+    'ha_area_get_environment_entities': 'READ',
+    'ha_area_set_temperature_entity': 'WRITE_REGISTRY',
+    'ha_service_call': 'WRITE_SERVICE',
+}
+FIELDS = {
+    'ha_area_create': ({'name'}, {'name', 'floor_id', 'icon', 'aliases'}),
+    'ha_area_update': ({'area_id'}, {'area_id', 'name', 'floor_id', 'icon', 'aliases'}),
+    'ha_area_get_environment_entities': ({'area_id'}, {'area_id'}),
+    'ha_area_set_temperature_entity': ({'area_id', 'entity_id'}, {'area_id', 'entity_id'}),
+    'ha_service_call': ({'domain', 'service', 'target'}, {'domain', 'service', 'target', 'data'}),
+}
+
+class Invalid(ValueError):
+    """Input cannot be executed."""
+
+class Denied(ValueError):
+    """Authorization cannot be accepted."""
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False, allow_nan=False).encode()
+
+def normalized(name):
+    return ' '.join(unicodedata.normalize('NFKC', name).split()).casefold()
+
+def text(value):
+    if not isinstance(value, str) or not value.strip() or len(value) > 128 or any(ord(c) < 32 for c in value):
+        raise Invalid('Invalid bounded string')
+
+def identifier(value):
+    if not isinstance(value, str) or not re.fullmatch(r'[a-z0-9_]{1,128}', value):
+        raise Invalid('Invalid registry identifier')
+
+def validate(operation, payload, dry_run):
+    if operation not in SCOPES:
+        raise Denied('Unknown operation')
+    if not isinstance(payload, dict) or type(dry_run) is not bool:
+        raise Invalid('Invalid request shape')
+    required, allowed = FIELDS[operation]
+    if required - payload.keys() or payload.keys() - allowed:
+        raise Invalid('Missing or forbidden fields')
+    if 'name' in payload:
+        text(payload['name'])
+    for key in ('area_id', 'floor_id'):
+        if key in payload and not (key == 'floor_id' and payload[key] is None):
+            identifier(payload[key])
+    if 'icon' in payload and payload['icon'] is not None:
+        if not isinstance(payload['icon'], str) or not re.fullmatch(r'mdi:[a-z0-9-]{1,80}', payload['icon']):
+            raise Invalid('Invalid icon')
+    if 'aliases' in payload and payload['aliases'] is not None:
+        if not isinstance(payload['aliases'], list) or len(payload['aliases']) > 32:
+            raise Invalid('Invalid aliases')
+        for alias in payload['aliases']:
+            text(alias)
+    if 'entity_id' in payload:
+        if not isinstance(payload['entity_id'], str) or not re.fullmatch(r'sensor\.[a-z0-9_]{1,128}', payload['entity_id']):
+            raise Invalid('Invalid sensor entity')
+    if operation == 'ha_service_call':
+        if (payload['domain'], payload['service']) != ('update', 'install'):
+            raise Denied('Service is not allowlisted')
+        if payload['target'] != {'entity_id': 'update.codex_update'}:
+            raise Denied('Target is not allowlisted')
+        data = payload.get('data', {})
+        if not isinstance(data, dict) or set(data) - {'version'}:
+            raise Invalid('Forbidden service data')
+        # Pin MVP to the approved upstream build; cannot install a future/unreviewed version.
+        if data.get('version', '0.1.70') not in ('0.1.70', 'v0.1.70'):
+            raise Denied('Version is not allowlisted')
+
+def target_for(operation, payload):
+    if operation == 'ha_area_create':
+        return {'normalized_name': normalized(payload['name'])}
+    if operation == 'ha_service_call':
+        return {'entity_id': 'update.codex_update'}
+    return {'area_id': payload['area_id']}
+
+REQUEST_KEYS = {'protocol_version', 'operation_id', 'task_id', 'turn_id', 'operation', 'scope', 'target', 'payload', 'dry_run'}
+
+def digest(request):
+    return hashlib.sha256(canonical(request)).hexdigest()
+
+def signature(secret, claims):
+    key = hmac.new(secret.encode(), b'codex-cli/write-v1', hashlib.sha256).digest()
+    return hmac.new(key, canonical(claims), hashlib.sha256).hexdigest()
+
+def authorize(request, proof, secret, now, seen):
+    if set(request) != REQUEST_KEYS or request.get('protocol_version') != PROTOCOL:
+        raise Invalid('Unsupported protocol or request shape')
+    validate(request['operation'], request['payload'], request['dry_run'])
+    for key in ('task_id', 'turn_id', 'operation_id'):
+        text(request[key])
+    if request['scope'] != SCOPES[request['operation']] or request['target'] != target_for(request['operation'], request['payload']):
+        raise Denied('Scope or target mismatch')
+    expected = {'task_id', 'turn_id', 'operation_id', 'allowed_operation', 'allowed_target', 'scope', 'expiration', 'nonce', 'request_digest'}
+    if not isinstance(proof, dict) or set(proof) != {'claims', 'signature'}:
+        raise Denied('Missing authorization')
+    claims = proof['claims']
+    if not isinstance(claims, dict) or set(claims) != expected:
+        raise Denied('Invalid authorization shape')
+    try:
+        valid_signature = hmac.compare_digest(signature(secret, claims), proof['signature'])
+    except (TypeError, ValueError):
+        raise Denied('Invalid authorization') from None
+    if not valid_signature:
+        raise Denied('Invalid authorization')
+    expiration = claims['expiration']
+    if type(expiration) not in (int, float) or not now < expiration <= now + 60:
+        raise Denied('Expired or excessive authorization lifetime')
+    checks = {'task_id': request['task_id'], 'turn_id': request['turn_id'], 'operation_id': request['operation_id'],
+              'allowed_operation': request['operation'], 'allowed_target': request['target'],
+              'scope': request['scope'], 'request_digest': digest(request)}
+    if any(claims[k] != v for k, v in checks.items()):
+        raise Denied('Authorization binding mismatch')
+    nonce = claims['nonce']
+    if not isinstance(nonce, str) or not re.fullmatch(r'[a-f0-9]{32}', nonce):
+        raise Denied('Invalid nonce')
+    for n, exp in list(seen.items()):
+        if exp <= now:
+            del seen[n]
+    if nonce in seen or len(seen) >= 4096:
+        raise Denied('Replay or authorization capacity exceeded')
+    seen[nonce] = expiration
+
+def result(request, status, before=None, after=None, verified=False, warnings=None):
+    # Never echo unvalidated attacker-controlled fields, even on error paths.
+    try:
+        validate(request.get('operation'), request.get('payload'), request.get('dry_run'))
+        safe_target = target_for(request['operation'], request['payload'])
+        safe_requested = request['payload']
+    except (Invalid, Denied, TypeError, KeyError):
+        safe_target, safe_requested = None, None
+    return {'status': status, 'operation_id': request.get('operation_id'), 'tool': request.get('operation'),
+            'target': safe_target, 'before': before, 'requested': safe_requested,
+            'after': after, 'verified': verified, 'restart_required': False, 'warnings': warnings or []}
