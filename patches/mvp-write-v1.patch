+        self.broker.execute('test-task','ha_area_create',{'name':'New'},True)
+        method,path,k=self.sent[0];self.assertEqual(path,'codex_cli/write_operation')
+        r=k['json'].copy();proof=r.pop('authorization');C.authorize(r,proof,SECRET,NOW,{})
+    def test_scope_in_argument_rejected(self):
+        self.broker.begin('test-task','test-turn',['WRITE_REGISTRY'])
+        self.assertEqual(self.broker.execute('test-task','ha_area_create',{'name':'New','scope':'SYSTEM_RESTART'})['status'],'VALIDATION_ERROR')
